# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca é commitado (está no .gitignore).
#
# Onde conseguir cada valor: Seller Central > Apps e Serviços > Desenvolver
# Apps > seu app SP-API. Os refresh tokens vêm da autorização do app
# contra cada conta Vendor (fluxo "Authorize" feito uma vez por conta).

# Credenciais do app LWA (Login With Amazon) cadastrado na Amazon.
# Compartilhadas por todas as contas.
SP_API_LWA_CLIENT_ID=
SP_API_LWA_CLIENT_SECRET=

# Segundo app SP-API. O primeiro so pode ser autorizado por ate 10 contas
# (limite de app "Draft" nao publicado) -- quando bate nesse teto, as contas
# seguintes usam um segundo app registrado do zero, com seu proprio client
# id/secret. Contas que usam esse segundo app tem 'app2': True no
# CONTAS_CONFIG de cada script de captura.
SP_API_LWA_CLIENT_ID_APP2=
SP_API_LWA_CLIENT_SECRET_APP2=

# ID do marketplace (Brasil = A2Q3Y263D00KWC, é o padrão se omitido)
SP_API_MARKETPLACE_ID=A2Q3Y263D00KWC

# Região do endpoint SP-API: NA, EU ou FE (padrão: NA)
SP_API_REGION=NA

# Um refresh token por conta. A chave usada nos JSONs do dashboard
# está entre parênteses.
SP_API_REFRESH_TOKEN_ALFAJF=       # alfa_jf
SP_API_REFRESH_TOKEN_BLIDSHOP=     # blidshop
SP_API_REFRESH_TOKEN_PETCLEAN=     # conta3 (Petclean BR)
SP_API_REFRESH_TOKEN_OZITP=        # ozitp
SP_API_REFRESH_TOKEN_JOLITEX=      # jolitex
SP_API_REFRESH_TOKEN_BALBOA=       # balboa
SP_API_REFRESH_TOKEN_RIOMASTER=    # riomaster
SP_API_REFRESH_TOKEN_PLASTPET=     # plastpet (Pet Factory Brazil Industria Ltda)
SP_API_REFRESH_TOKEN_WIWU=         # wiwu
SP_API_REFRESH_TOKEN_PETIKO=       # petiko
SP_API_REFRESH_TOKEN_NEWPET=       # new_pet (autorizada pelo 2o app -- ver SP_API_LWA_CLIENT_ID_APP2)

# SMTP (Gmail/Workspace) para notificar_pedidos.py (alerta de PO novo por email).
# A senha e uma "senha de app" (myaccount.google.com/apppasswords), NAO a senha normal
# da conta -- so fica disponivel depois de ativar a verificacao em duas etapas.
GMAIL_USER=
GMAIL_APP_PASSWORD=
